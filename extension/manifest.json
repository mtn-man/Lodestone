{
  "manifest_version": 3,
  "name": "Lodestone",
  "description": "Forward magnet links to a remote Transmission daemon over its JSON-RPC endpoint.",
  "version": "0.1.0",
  "background": {
    "scripts": ["lib/magnet.js", "lib/transmission-client.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": ["contextMenus", "storage"],
  "optional_host_permissions": ["*://*/*"],
  "icons": {
    "48": "lib/icons/icon-48.png",
    "64": "lib/icons/icon-64.png",
    "96": "lib/icons/icon-96.png",
    "128": "lib/icons/icon-128.png",
    "256": "lib/icons/icon-256.png",
    "512": "lib/icons/icon-512.png"
  },
  "action": {
    "default_title": "Lodestone",
    "default_icon": {
      "16": "lib/icons/icon-toolbar-16.png",
      "19": "lib/icons/icon-toolbar-19.png",
      "32": "lib/icons/icon-toolbar-32.png",
      "38": "lib/icons/icon-toolbar-38.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
