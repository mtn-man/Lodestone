{
  "manifest_version": 3,
  "name": "Lodestone",
  "description": "Forward magnet links to a remote Transmission daemon over its JSON-RPC endpoint.",
  "version": "0.1.0",
  "background": {
    "scripts": ["lib/magnet.js", "lib/transmission-client.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": ["contextMenus", "storage"],
  "optional_host_permissions": ["*://*/*"],
  "action": {
    "default_title": "Lodestone"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
